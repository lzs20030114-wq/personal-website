{
  "name": "personal-website",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "demo": "vite",
    "build": "npm run test && vite build && next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "skin:terminals": "node scripts/skin-terminal/generate.mjs",
    "pretest": "npm run skin:terminals",
    "pretypecheck": "npm run skin:terminals",
    "predev": "node scripts/copy-assets.mjs && npm run skin:terminals",
    "prebuild": "node scripts/copy-assets.mjs",
    "field:shots": "node scripts/home-field/capture.mjs",
    "design:tokens": "node scripts/design-system/tokens.mjs --check"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.24",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "~8.1.6",
    "vitest": "~4.1.12"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "gray-matter": "^4.0.3",
    "next": "^16.4.2",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "//overrides": "保留 postcss 与 sharp 的兼容安全补丁下限。安全公告会变化，更新后以 npm audit 和完整构建复核，不执行可能跨主版本升级或降级的 npm audit fix --force。",
  "overrides": {
    "postcss": "^8.5.24",
    "sharp": "^0.35.5"
  }
}
